# Run pnpm env:init to create an ignored .env with random LOCAL credentials.
# Blank secrets are intentional. Never use local credentials for production.
NODE_ENV=development
POSTGRES_USER=lucy_dev
POSTGRES_DB=lucy_spa_dev
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
# Authentication: run pnpm auth:env:init for a separate ignored .env.auth.local.
# Production must inject independent CSPRNG keys and use an HTTPS WEB_ORIGIN.
# Key-ring syntax: JSON object mapping positive versions to base64url keys >=32 bytes.
# AUTH_CSRF_KEYS={"1":"<external-random-key>"}
# AUTH_CSRF_ACTIVE_VERSION=1
# AUTH_THROTTLE_KEYS={"1":"<different-external-random-key>"}
# AUTH_THROTTLE_ACTIVE_VERSION=1
# AUTH_OTP_KEYS={"1":"<third-independent-random-key>"}
# AUTH_OTP_ACTIVE_VERSION=1
# AUTH_DELIVERY_KEYS={"1":"<fourth-independent-random-key>"}
# AUTH_DELIVERY_ACTIVE_VERSION=1
# The OTP and delivery rings are required by customer registration/activation;
# without both, those routes fail closed with 503 before any write.
# AUTH_OTP_IP_ISSUE_LIMIT=30
# AUTH_ALLOW_INSECURE_LOCAL_COOKIE=true is permitted only for explicit loopback HTTP development.
# Defaults: anonymous 900s, idle 1800s, absolute 43200s, fresh password proof 300s.
# AUTH_CONTEXT_LIMIT=30
# AUTH_CONTEXT_WINDOW_SECONDS=900
# Web process only: API_UPSTREAM_ORIGIN=http://127.0.0.1:3001
# Optional explicit development branch seed; no default production branch or Owner.
DEV_SEED_BRANCH_CODE=
DEV_SEED_BRANCH_NAME=
