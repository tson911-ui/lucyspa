# Run pnpm env:init to create an ignored .env with random LOCAL credentials.
# Blank secrets are intentional. Never use local credentials for production.
NODE_ENV=development
POSTGRES_USER=lucy_dev
POSTGRES_DB=lucy_spa_dev
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
# Optional explicit development branch seed; no default production branch or Owner.
DEV_SEED_BRANCH_CODE=
DEV_SEED_BRANCH_NAME=
