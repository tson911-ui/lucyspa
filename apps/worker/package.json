{
  "name": "@lucy-spa/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "node --test \"dist/**/*.test.js\"",
    "smoke": "node --env-file-if-exists=../../.env dist/smoke.js"
  },
  "dependencies": {
    "@lucy-spa/database": "workspace:*",
    "@lucy-spa/server": "workspace:*",
    "bullmq": "5.81.5"
  },
  "devDependencies": {
    "@lucy-spa/config": "workspace:*"
  }
}
