{
  "name": "@lucy-spa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.auth.local dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.auth.local dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"dist/**/*.test.js\"",
    "test:integration": "node --env-file-if-exists=../../.env --test ../../scripts/test-auth-integration.mjs",
    "owner:bootstrap": "node --env-file-if-exists=../../.env dist/bootstrap/bootstrap-owner.cli.js",
    "owner:reset-password": "node --env-file-if-exists=../../.env dist/bootstrap/owner-password-reset.cli.js"
  },
  "dependencies": {
    "@lucy-spa/contracts": "workspace:*",
    "@lucy-spa/database": "workspace:*",
    "@lucy-spa/server": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "ioredis": "5.8.2",
    "libphonenumber-js": "1.13.13",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@lucy-spa/config": "workspace:*",
    "@nestjs/testing": "11.2.5",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "@types/validator": "13.15.10",
    "supertest": "7.2.2",
    "tsc-watch": "7.2.1"
  }
}
