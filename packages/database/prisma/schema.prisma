generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// Phase 0 branch identity, extended only with Phase 1 authorization relations.
model Branch {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                       @unique
  name                String
  timezone            String                       @default("Asia/Ho_Chi_Minh")
  isActive            Boolean                      @default(true) @map("is_active")
  rowVersion          Int                          @default(1) @map("row_version")
  areaId              String?                      @map("area_id") @db.Uuid
  area                Area?                        @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teams               Team[]
  teamMemberships     TeamMembership[]
  organizationAssignments OrganizationAssignment[]
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  outboxEvents        OutboxEvent[]
  employeeAssignments EmployeeBranchAssignment[]
  roleAssignments     UserRoleAssignment[]
  permissionOverrides UserPermissionOverride[]
  auditEvents         AuditEvent[]
  serviceAvailability ServiceBranchAvailability[]
  operatingHours      BranchOperatingHours[]
  attendanceRecords   AttendanceRecord[]
  collaboratorWork    CollaboratorWorkOccurrence[]
  bookings            Booking[]
  visits              Visit[]
  notifications       Notification[]
  invoices            Invoice[]
  payments            Payment[]

  @@index([areaId], map: "branches_area_idx")
  @@map("branches")
}

// Durable event envelope, written in the originating business transaction.
// Publication/consumer behavior is deliberately deferred. Retain event history.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  schemaVersion Int       @default(1) @map("schema_version")
  payload       Json      @db.JsonB
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  notifications Notification[]

  @@index([publishedAt, occurredAt, id], map: "outbox_events_pending_idx")
  @@index([branchId], map: "outbox_events_branch_id_idx")
  @@map("outbox_events")
}

// Durable in-app inbox. Delivery retries never overwrite read state.
model Notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId        String?   @map("branch_id") @db.Uuid
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceEventId   String    @map("source_event_id") @db.Uuid
  sourceEvent     OutboxEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type            String
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id") @db.Uuid
  contextCode     String    @map("context_code")
  actionAt        DateTime  @map("action_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  /// Structured ids/dates/enums only (validated by parseNotificationParams); never free text.
  params          Json?     @db.JsonB
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)

  @@unique([sourceEventId, recipientUserId], map: "notifications_event_recipient_key")
  @@index([recipientUserId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_inbox_idx")
  @@index([recipientUserId, readAt], map: "notifications_unread_idx")
  @@map("notifications")
}

// Recoverable timer metadata, never execution state. Reuse the source warning facts.
model ServiceWarningSchedule {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineId    String           @map("line_id") @db.Uuid
  line      VisitServiceLine @relation(fields: [lineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind      String
  targetAt  DateTime         @map("target_at") @db.Timestamptz(3)
  dueAt     DateTime         @map("due_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([lineId, kind, targetAt], map: "service_warning_schedules_occurrence_key")
  @@map("service_warning_schedules")
}

enum UserKind {
  CUSTOMER
  EMPLOYEE
  OWNER
}

enum UserStatus {
  PENDING_SETUP
  ACTIVE
  INACTIVE
}

enum PreferredLocale {
  vi
  en
}

enum AuthChallengePurpose {
  ACTIVATE_CUSTOMER
  RESET_PASSWORD
  VERIFY_RECOVERY_EMAIL
  EMPLOYEE_SETUP
  CHANGE_EMAIL
}

enum AuthDeliveryState {
  PENDING
  DELIVERED
  FAILED
  INVALIDATED
  EXPIRED
}

enum SessionKind {
  ANONYMOUS
  AUTHENTICATED
}

enum ScopeKind {
  GLOBAL
  REGION
  AREA
  BRANCH
}

// Code-owned hierarchy semantics; labels and role names never grant authority.
enum OrganizationLevel {
  CEO
  REGIONAL_MANAGER
  AREA_MANAGER
  STORE_MANAGER
  DEPUTY_STORE_MANAGER
  TEAM_LEADER
}

model Region {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String
  isActive Boolean @default(true) @map("is_active")
  rowVersion Int @default(1) @map("row_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  areas Area[]
  roleAssignments UserRoleAssignment[]
  permissionOverrides UserPermissionOverride[]
  organizationAssignments OrganizationAssignment[]
  @@map("regions")
}

model Area {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId String @map("region_id") @db.Uuid
  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code String @unique
  name String
  isActive Boolean @default(true) @map("is_active")
  rowVersion Int @default(1) @map("row_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  branches Branch[]
  roleAssignments UserRoleAssignment[]
  permissionOverrides UserPermissionOverride[]
  organizationAssignments OrganizationAssignment[]
  @@index([regionId, isActive], map: "areas_region_active_idx")
  @@map("areas")
}

model Team {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code String
  name String
  isActive Boolean @default(true) @map("is_active")
  rowVersion Int @default(1) @map("row_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships TeamMembership[]
  organizationAssignments OrganizationAssignment[]
  @@unique([branchId, code], map: "teams_branch_code_key")
  @@unique([id, branchId], map: "teams_id_branch_key")
  @@index([branchId, isActive, id], map: "teams_branch_active_idx")
  @@map("teams")
}

// Appointments are ended, never overwritten/deleted. Owner has no employee appointment.
model OrganizationAssignment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeUserId String @map("employee_user_id") @db.Uuid
  employee EmployeeProfile @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  level OrganizationLevel
  scopeKind ScopeKind @map("scope_kind")
  regionId String? @map("region_id") @db.Uuid
  region Region? @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  areaId String? @map("area_id") @db.Uuid
  area Area? @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId String? @map("branch_id") @db.Uuid
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teamId String? @map("team_id") @db.Uuid
  team Team? @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt DateTime? @map("ended_at") @db.Timestamptz(3)
  assignedByUserId String @map("assigned_by_user_id") @db.Uuid
  assignedBy User @relation("OrganizationAssignmentGrantor", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rowVersion Int @default(1) @map("row_version")
  @@index([employeeUserId, endedAt], map: "organization_assignments_employee_active_idx")
  @@index([scopeKind, regionId, areaId, branchId, endedAt], map: "organization_assignments_scope_idx")
  @@index([teamId, endedAt], map: "organization_assignments_team_idx")
  @@map("organization_assignments")
}

model TeamMembership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId String @map("branch_id") @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeUserId String @map("employee_user_id") @db.Uuid
  employee EmployeeProfile @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  endedAt DateTime? @map("ended_at") @db.Timestamptz(3)
  assignedByUserId String @map("assigned_by_user_id") @db.Uuid
  assignedBy User @relation("TeamMembershipGrantor", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([teamId, endedAt, employeeUserId], map: "team_memberships_team_active_idx")
  @@index([employeeUserId, branchId, endedAt], map: "team_memberships_employee_active_idx")
  @@map("team_memberships")
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum ScopeCapability {
  GLOBAL_ONLY
  BRANCH_CAPABLE
}

enum DataClassification {
  STANDARD
  EMPLOYEE_PAY
  FINANCIAL
}

enum AuditActorKind {
  USER
  BOOTSTRAP
  SYSTEM
}

// Executable permission semantics are code-owned; role names carry no authority.
enum PermissionCode {
  VIEW_ORGANIZATION
  MANAGE_ORGANIZATION
  MANAGE_ORG_ASSIGNMENTS
  VIEW_TEAMS
  MANAGE_TEAMS
  VIEW_EMPLOYEES
  CREATE_EMPLOYEES
  UPDATE_EMPLOYEES
  MANAGE_EMPLOYEE_STATUS
  MANAGE_EMPLOYEE_ACCESS
  MANAGE_EMPLOYEE_SCOPE
  VIEW_EMPLOYEE_PAY
  MANAGE_EMPLOYEE_PAY
  MANAGE_PERMISSIONS
  VIEW_AUDIT_LOG
  MANAGE_BRANCHES
  MANAGE_SERVICES
  MANAGE_SERVICE_PRICES
  MANAGE_SKILLS
  VIEW_ATTENDANCE
  MANAGE_ATTENDANCE
  APPROVE_LEAVE
  VIEW_WORK_SCHEDULE
  MANAGE_WORK_SCHEDULE
  VIEW_BOOKINGS
  MANAGE_BOOKINGS
  MANAGE_QUEUE
  REASSIGN_SERVICES
  PERFORM_SERVICES
  RESOLVE_SERVICE_EXECUTION
  MANAGE_BOOKING_SETTINGS
  VIEW_INVOICES
  MANAGE_INVOICES
  COLLECT_PAYMENTS
  APPLY_DISCOUNTS
  MANAGE_DISCOUNTS
  CREATE_VOUCHERS
  CANCEL_INVOICES
  CORRECT_PAYMENTS
  VIEW_REVENUE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// What the leave is for. Paid/unpaid treatment is future Leave Policy, not the type.
enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  FAMILY_EVENT
  MATERNITY
  OTHER
}

// SQL additionally enforces kind/profile consistency at transaction commit,
// canonical identities, credential state and protected sole-Owner invariants.
model User {
  id                           String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                         UserKind
  status                       UserStatus
  fullName                     String                           @map("full_name")
  preferredLocale              PreferredLocale                  @map("preferred_locale")
  emailCanonical               String?                          @unique(map: "users_email_canonical_key") @map("email_canonical") @db.VarChar(254)
  emailDelivery                String?                          @map("email_delivery") @db.VarChar(254)
  emailVerifiedAt              DateTime?                        @map("email_verified_at") @db.Timestamptz(3)
  phoneCanonical               String?                          @unique(map: "users_phone_canonical_key") @map("phone_canonical") @db.VarChar(16)
  normalizationVersion         Int                              @map("normalization_version")
  passwordHash                 String?                          @map("password_hash")
  credentialVersion            Int                              @default(1) @map("credential_version")
  authzVersion                 Int                              @default(1) @map("authz_version")
  rowVersion                   Int                              @default(1) @map("row_version")
  createdAt                    DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  customerProfile              CustomerProfile?
  notifications                Notification[]
  employeeProfile              EmployeeProfile?
  grantedBranchAssignments     EmployeeBranchAssignment[]       @relation("BranchAssignmentGrantor")
  completedRegistrationIntents RegistrationIntent[]
  authChallenges               AuthChallenge[]
  sessions                     Session[]
  roleAssignments              UserRoleAssignment[]
  permissionOverrides          UserPermissionOverride[]
  actorAuditEvents             AuditEvent[]                     @relation("AuditActor")
  subjectAuditEvents           AuditEvent[]                     @relation("AuditSubject")
  grantedEmployeeSkills        EmployeeSkill[]                  @relation("EmployeeSkillGrantor")
  decidedLeaveRequests         LeaveRequest[]                   @relation("LeaveDecider")
  cancelledLeaveRequests       LeaveRequest[]                   @relation("LeaveCanceller")
  recordedClassifications      EmploymentClassificationChange[] @relation("ClassificationRecorder")
  createdCollaboratorWork      CollaboratorWorkOccurrence[]     @relation("CollaboratorWorkCreator")
  updatedCollaboratorWork      CollaboratorWorkOccurrence[]     @relation("CollaboratorWorkUpdater")
  cancelledCollaboratorWork    CollaboratorWorkOccurrence[]     @relation("CollaboratorWorkCanceller")
  ownedBookings                Booking[]                        @relation("BookingOwner")
  createdBookings              Booking[]                        @relation("BookingCreator")
  checkedInBookings            Booking[]                        @relation("BookingCheckedInBy")
  cancelledBookings            Booking[]                        @relation("BookingCancelledBy")
  noShowBookings               Booking[]                        @relation("BookingNoShowBy")
  ownedVisits                  Visit[]                          @relation("VisitOwner")
  createdVisits                Visit[]                          @relation("VisitCreator")
  cancelledVisits              Visit[]                          @relation("VisitCancelledBy")
  queueOverriddenVisits        Visit[]                          @relation("VisitQueueOverrideBy")
  visitParticipations          VisitParticipant[]
  addedVisitLines              VisitServiceLine[]               @relation("VisitLineAddedBy")
  cancelledVisitLines          VisitServiceLine[]               @relation("VisitLineCancelledBy")
  endedServiceExecutions       ServiceExecution[]               @relation("ExecutionEndedBy")
  assignmentChanges            ServiceLineAssignmentChange[]    @relation("AssignmentActor")
  visitLineAddRequests         VisitLineAddRequest[]
  payerInvoices                Invoice[]                        @relation("InvoicePayer")
  createdInvoices              Invoice[]                        @relation("InvoiceCreator")
  finalizedInvoices            Invoice[]                        @relation("InvoiceFinalizedBy")
  cancelledInvoices            Invoice[]                        @relation("InvoiceCancelledBy")
  pricedInvoiceLines           InvoiceLine[]                    @relation("InvoiceLinePriceSetBy")
  collectedPayments            Payment[]                        @relation("PaymentCollector")
  paymentCorrections           PaymentCorrection[]              @relation("PaymentCorrectionActor")
  terminatedDiscounts          Discount[]                       @relation("DiscountTerminatedBy")
  createdDiscountVersions      DiscountVersion[]                @relation("DiscountVersionCreator")
  createdVouchers              Voucher[]                        @relation("VoucherCreator")
  suppliedVoucherEntries       InvoiceVoucherEntry[]            @relation("VoucherEntrySuppliedBy")
  removedVoucherEntries        InvoiceVoucherEntry[]            @relation("VoucherEntryRemovedBy")
  finalizedDiscountApplications InvoiceDiscountApplication[]    @relation("DiscountApplicationFinalizer")
  discountRedemptions          DiscountRedemption[]             @relation("DiscountRedemptionPayer")
  releasedDiscountRedemptions  DiscountRedemptionRelease[]      @relation("DiscountReleaseActor")
  updatedSettings              AppSetting[]
  grantedOrganizationAssignments OrganizationAssignment[] @relation("OrganizationAssignmentGrantor")
  grantedTeamMemberships       TeamMembership[] @relation("TeamMembershipGrantor")

  @@index([kind, status, id], map: "users_kind_status_idx")
  @@map("users")
}

model CustomerProfile {
  userId      String   @id @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  address     String

  @@map("customer_profiles")
}

model EmployeeProfile {
  userId                String                           @id @map("user_id") @db.Uuid
  user                  User                             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeCodeCanonical String                           @unique(map: "employee_profiles_employee_code_canonical_key") @map("employee_code_canonical") @db.VarChar(64)
  dateOfBirth           DateTime                         @map("date_of_birth") @db.Date
  address               String
  baseSalaryVnd         BigInt?                          @map("base_salary_vnd")
  branchAssignments     EmployeeBranchAssignment[]
  organizationAssignments OrganizationAssignment[]
  teamMemberships       TeamMembership[]
  skills                EmployeeSkill[]
  attendanceRecords     AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  classificationChanges EmploymentClassificationChange[]
  collaboratorWork      CollaboratorWorkOccurrence[]
  bookingLines          BookingServiceLine[]
  visitLines            VisitServiceLine[]               @relation("VisitLineEmployee")
  requestedVisitLines   VisitServiceLine[]               @relation("VisitLineRequestedEmployee")
  serviceExecutions     ServiceExecution[]
  invoiceLineServices   InvoiceLineService[]
  assignmentsFrom       ServiceLineAssignmentChange[]    @relation("AssignmentFrom")
  assignmentsTo         ServiceLineAssignmentChange[]    @relation("AssignmentTo")

  @@map("employee_profiles")
}

// Revocation preserves membership history; SQL permits one active user/branch pair.
// Employment classification, separate from account status (User.status), roles, branches
// and skills. Payroll-eligible only while OFFICIAL_EMPLOYEE.
enum EmploymentClassification {
  TRAINEE
  COLLABORATOR
  OFFICIAL_EMPLOYEE
  ENDED
}

// Append-only, effective-dated classification history (SQL guards transitions, ordering and
// immutability). The classification on date D is the change with the latest effectiveDate <= D.
model EmploymentClassificationChange {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeUserId   String                   @map("employee_user_id") @db.Uuid
  employee         EmployeeProfile          @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  classification   EmploymentClassification
  effectiveDate    DateTime                 @map("effective_date") @db.Date
  reason           String?
  /// Null only for rows backfilled by the migration that introduced this history.
  recordedByUserId String?                  @map("recorded_by_user_id") @db.Uuid
  recordedBy       User?                    @relation("ClassificationRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedAt       DateTime                 @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@unique([employeeUserId, effectiveDate], map: "employment_classification_changes_employee_date_key")
  @@index([recordedByUserId], map: "employment_classification_changes_recorder_idx")
  @@map("employment_classification_changes")
}

model EmployeeBranchAssignment {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeUserId  String          @map("employee_user_id") @db.Uuid
  employee        EmployeeProfile @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  branchId        String          @map("branch_id") @db.Uuid
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedAt       DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)
  grantedByUserId String          @map("granted_by_user_id") @db.Uuid
  grantedBy       User            @relation("BranchAssignmentGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([employeeUserId, revokedAt, branchId], map: "employee_branch_assignments_user_scope_idx")
  @@index([branchId, revokedAt, employeeUserId], map: "employee_branch_assignments_branch_scope_idx")
  @@index([grantedByUserId], map: "employee_branch_assignments_grantor_idx")
  @@map("employee_branch_assignments")
}

// Candidate identifiers deliberately do not reserve unique User identities.
// Terminal candidate records are transient and may be removed by bounded cleanup.
model RegistrationIntent {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailCanonical       String          @map("email_canonical") @db.VarChar(254)
  emailDelivery        String          @map("email_delivery") @db.VarChar(254)
  phoneCanonical       String          @map("phone_canonical") @db.VarChar(16)
  normalizationVersion Int             @map("normalization_version")
  passwordHash         String          @map("password_hash")
  fullName             String          @map("full_name")
  dateOfBirth          DateTime        @map("date_of_birth") @db.Date
  address              String
  preferredLocale      PreferredLocale @map("preferred_locale")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime        @map("expires_at") @db.Timestamptz(3)
  completedAt          DateTime?       @map("completed_at") @db.Timestamptz(3)
  invalidatedAt        DateTime?       @map("invalidated_at") @db.Timestamptz(3)
  completedUserId      String?         @map("completed_user_id") @db.Uuid
  completedUser        User?           @relation(fields: [completedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  challenges           AuthChallenge[]

  @@index([emailCanonical, expiresAt], map: "registration_intents_email_expiry_idx")
  @@index([expiresAt, id], map: "registration_intents_expiry_idx")
  @@index([completedUserId], map: "registration_intents_completed_user_idx")
  @@map("registration_intents")
}

// SQL checks the XOR subject, purpose-specific material and irreversible terminal
// state. Actionable identity/purpose uniqueness is a reviewed partial SQL index.
model AuthChallenge {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose               AuthChallengePurpose
  flowTokenHash         Bytes                @unique(map: "auth_challenges_flow_token_hash_key") @map("flow_token_hash")
  identityKey           Bytes                @map("identity_key")
  identityKeyVersion    Int                  @map("identity_key_version")
  registrationIntentId  String?              @map("registration_intent_id") @db.Uuid
  registrationIntent    RegistrationIntent?  @relation(fields: [registrationIntentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId                String?              @map("user_id") @db.Uuid
  user                  User?                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  generation            Int                  @default(1)
  verifierDigest        Bytes?               @map("verifier_digest")
  keyVersion            Int?                 @map("key_version")
  credentialVersion     Int?                 @map("credential_version")
  authzVersion          Int?                 @map("authz_version")
  deliveryEmailSnapshot String?              @map("delivery_email_snapshot") @db.VarChar(254)
  failedAttempts        Int                  @default(0) @map("failed_attempts")
  maxAttempts           Int                  @map("max_attempts")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  flowExpiresAt         DateTime             @map("flow_expires_at") @db.Timestamptz(3)
  codeGeneratedAt       DateTime?            @map("code_generated_at") @db.Timestamptz(3)
  codeExpiresAt         DateTime?            @map("code_expires_at") @db.Timestamptz(3)
  consumedAt            DateTime?            @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt         DateTime?            @map("invalidated_at") @db.Timestamptz(3)
  deliveries            AuthDelivery[]

  @@index([userId, purpose], map: "auth_challenges_user_purpose_idx")
  @@index([registrationIntentId], map: "auth_challenges_intent_idx")
  @@index([flowExpiresAt, id], map: "auth_challenges_flow_expiry_idx")
  @@index([codeExpiresAt, id], map: "auth_challenges_code_expiry_idx")
  @@map("auth_challenges")
}

// Only temporary encrypted recipient/code material belongs here. The existing
// outbox references this ID in a versioned payload and never carries secrets.
model AuthDelivery {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId       String            @map("challenge_id") @db.Uuid
  challenge         AuthChallenge     @relation(fields: [challengeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  generation        Int
  state             AuthDeliveryState @default(PENDING)
  encryptedPayload  Bytes?            @map("encrypted_payload")
  nonce             Bytes?
  tag               Bytes?
  keyVersion        Int?              @map("key_version")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime          @map("expires_at") @db.Timestamptz(3)
  attempts          Int               @default(0)
  nextAttemptAt     DateTime          @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken        Bytes?            @map("lease_token")
  leaseUntil        DateTime?         @map("lease_until") @db.Timestamptz(3)
  deliveredAt       DateTime?         @map("delivered_at") @db.Timestamptz(3)
  providerMessageId String?           @map("provider_message_id")
  safeErrorCode     String?           @map("safe_error_code")

  @@unique([challengeId, generation], map: "auth_deliveries_challenge_generation_key")
  @@index([state, nextAttemptAt, leaseUntil, id], map: "auth_deliveries_claim_idx")
  @@index([expiresAt, id], map: "auth_deliveries_expiry_idx")
  @@map("auth_deliveries")
}

model Session {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash         Bytes       @unique(map: "sessions_token_hash_key") @map("token_hash")
  kind              SessionKind
  userId            String?     @map("user_id") @db.Uuid
  user              User?       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credentialVersion Int?        @map("credential_version")
  authzVersion      Int?        @map("authz_version")
  csrfKeyVersion    Int         @map("csrf_key_version")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActivityAt    DateTime    @map("last_activity_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime    @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?   @map("revoked_at") @db.Timestamptz(3)
  reauthenticatedAt DateTime?   @map("reauthenticated_at") @db.Timestamptz(3)

  @@index([userId, revokedAt, absoluteExpiresAt], map: "sessions_user_revocation_expiry_idx")
  @@index([absoluteExpiresAt, id], map: "sessions_expiry_idx")
  @@map("sessions")
}

// Unknown identities/IPs receive the same limits without storing their raw values.
// A zero-second epoch window is a separate persistent cooldown bucket in SQL.
model AuthThrottleBucket {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationBucket String    @map("operation_bucket")
  pseudonymousKey Bytes     @map("pseudonymous_key")
  keyVersion      Int       @map("key_version")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  windowSeconds   Int       @map("window_seconds")
  count           Int       @default(0)
  nextAllowedAt   DateTime? @map("next_allowed_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)

  @@unique([operationBucket, pseudonymousKey, keyVersion, windowStartedAt, windowSeconds], map: "auth_throttle_buckets_operation_key_window_key")
  @@index([expiresAt, id], map: "auth_throttle_buckets_expiry_idx")
  @@map("auth_throttle_buckets")
}

model Role {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String               @unique(map: "roles_code_key")
  displayNameVi   String               @map("display_name_vi")
  displayNameEn   String               @map("display_name_en")
  isActive        Boolean              @default(true) @map("is_active")
  /// Display grouping only (the "Quản lý" section of the employee directory); grants nothing.
  isManagerGroup  Boolean              @default(false) @map("is_manager_group")
  rowVersion      Int                  @default(1) @map("row_version")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               PermissionCode           @unique(map: "permissions_code_key")
  scopeCapability    ScopeCapability          @map("scope_capability")
  dataClassification DataClassification       @map("data_classification")
  roles              RolePermission[]
  userOverrides      UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_idx")
  @@map("role_permissions")
}

// SQL enforces EMPLOYEE recipients and distinct GLOBAL/BRANCH unique scopes.
model UserRoleAssignment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roleId     String    @map("role_id") @db.Uuid
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scopeKind  ScopeKind @map("scope_kind")
  regionId   String?   @map("region_id") @db.Uuid
  region     Region?  @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  areaId     String?   @map("area_id") @db.Uuid
  area       Area?    @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId   String?   @map("branch_id") @db.Uuid
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rowVersion Int       @default(1) @map("row_version")

  @@index([userId, scopeKind, branchId], map: "user_role_assignments_user_scope_idx")
  @@index([roleId], map: "user_role_assignments_role_idx")
  @@index([branchId], map: "user_role_assignments_branch_idx")
  @@index([regionId], map: "user_role_assignments_region_idx")
  @@index([areaId], map: "user_role_assignments_area_idx")
  @@map("user_role_assignments")
}

model UserPermissionOverride {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissionId String           @map("permission_id") @db.Uuid
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  effect       PermissionEffect
  scopeKind    ScopeKind        @map("scope_kind")
  regionId     String?          @map("region_id") @db.Uuid
  region       Region?          @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  areaId       String?          @map("area_id") @db.Uuid
  area         Area?            @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId     String?          @map("branch_id") @db.Uuid
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rowVersion   Int              @default(1) @map("row_version")

  @@index([userId, scopeKind, branchId], map: "user_permission_overrides_user_scope_idx")
  @@index([permissionId], map: "user_permission_overrides_permission_idx")
  @@index([branchId], map: "user_permission_overrides_branch_idx")
  @@index([regionId], map: "user_permission_overrides_region_idx")
  @@index([areaId], map: "user_permission_overrides_area_idx")
  @@map("user_permission_overrides")
}

// SQL protects append-only history; runtime database roles must also lack table
// ownership, DDL, UPDATE, DELETE and TRUNCATE rights. JSON uses action allowlists.
model AuditEvent {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemaVersion      Int                @default(1) @map("schema_version")
  action             String
  occurredAt         DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorKind          AuditActorKind     @map("actor_kind")
  actorUserId        String?            @map("actor_user_id") @db.Uuid
  actor              User?              @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectUserId      String?            @map("subject_user_id") @db.Uuid
  subject            User?              @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entityType         String             @map("entity_type")
  entityId           String             @map("entity_id")
  branchId           String?            @map("branch_id") @db.Uuid
  branch             Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestId          String?            @map("request_id")
  correlationId      String?            @map("correlation_id")
  reason             String?
  before             Json?              @db.JsonB
  after              Json?              @db.JsonB
  dataClassification DataClassification @map("data_classification")

  @@index([occurredAt, id], map: "audit_events_time_idx")
  @@index([actorUserId, occurredAt, id], map: "audit_events_actor_idx")
  @@index([subjectUserId, occurredAt, id], map: "audit_events_subject_idx")
  @@index([entityType, entityId, occurredAt, id], map: "audit_events_entity_idx")
  @@index([branchId, action, occurredAt, id], map: "audit_events_branch_action_idx")
  @@index([action, occurredAt, id], map: "audit_events_action_idx")
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Phase 2: services, skills, operations. SQL adds canonical-code, range, history
// and state-transition guards that Prisma cannot express.

model ServiceCategory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique(map: "service_categories_code_key")
  nameVi     String    @map("name_vi")
  nameEn     String    @map("name_en")
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  rowVersion Int       @default(1) @map("row_version")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  services   Service[]
  discountVersionCategories DiscountVersionCategory[]

  @@index([isActive, sortOrder, id], map: "service_categories_active_order_idx")
  @@map("service_categories")
}

// One concrete duration per service; 30/60-minute offerings are separate services.
// durationMinutes is internal scheduling data, never a public menu label.
// What one service price applies to. Add units only for real menu data.
enum ServicePricingUnit {
  PER_SERVICE
  PER_NAIL
}

model Service {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                      @unique(map: "services_code_key")
  categoryId          String                      @map("category_id") @db.Uuid
  category            ServiceCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nameVi              String                      @map("name_vi")
  nameEn              String                      @map("name_en")
  descriptionVi       String?                     @map("description_vi")
  descriptionEn       String?                     @map("description_en")
  /// Minimum price per pricing unit (the price itself when exact); SQL: 0 <= min <= max.
  priceVnd            BigInt                      @map("price_vnd")
  priceMaxVnd         BigInt                      @map("price_max_vnd")
  pricingUnit         ServicePricingUnit          @default(PER_SERVICE) @map("pricing_unit")
  /// Phase 4 OP-1: the per-service limit of the invoice-line quantity (1 for PER_SERVICE; the Owner
  /// raises it for PER_NAIL). Snapshotted on booking and visit lines when they are established.
  maxQuantity         Int                         @default(1) @map("max_quantity")
  /// Internal scheduling duration: the one deterministic duration booking reserves.
  durationMinutes     Int                         @map("duration_minutes")
  /// Customer-facing estimate; SQL enforces 1 <= min <= max <= durationMinutes.
  estimatedMinMinutes Int                         @map("estimated_min_minutes")
  estimatedMaxMinutes Int                         @map("estimated_max_minutes")
  isActive            Boolean                     @default(true) @map("is_active")
  rowVersion          Int                         @default(1) @map("row_version")
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  eligibleSkills      ServiceSkill[]
  branches            ServiceBranchAvailability[]
  bookingLines        BookingServiceLine[]
  visitLines          VisitServiceLine[]
  invoiceLineServices InvoiceLineService[]
  discountVersionServices DiscountVersionService[]

  @@index([categoryId, isActive, id], map: "services_category_idx")
  @@map("services")
}

model Skill {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String          @unique(map: "skills_code_key")
  nameVi     String          @map("name_vi")
  nameEn     String          @map("name_en")
  isActive   Boolean         @default(true) @map("is_active")
  rowVersion Int             @default(1) @map("row_version")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  services   ServiceSkill[]
  employees  EmployeeSkill[]

  @@map("skills")
}

// Eligible skills: an employee holding ANY one of them qualifies (evaluated in Phase 3).
model ServiceSkill {
  serviceId String   @map("service_id") @db.Uuid
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  skillId   String   @map("skill_id") @db.Uuid
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([serviceId, skillId])
  @@index([skillId], map: "service_skills_skill_idx")
  @@map("service_skills")
}

// Explicit offering: a service with no active row for a branch is not offered there.
model ServiceBranchAvailability {
  serviceId  String   @map("service_id") @db.Uuid
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  isActive   Boolean  @default(true) @map("is_active")
  rowVersion Int      @default(1) @map("row_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([serviceId, branchId])
  @@index([branchId, isActive, serviceId], map: "service_branch_availability_branch_idx")
  @@map("service_branch_availability")
}

// Revocation preserves history; SQL permits one active employee/skill pair.
model EmployeeSkill {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeUserId  String          @map("employee_user_id") @db.Uuid
  employee        EmployeeProfile @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  skillId         String          @map("skill_id") @db.Uuid
  skill           Skill           @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedAt       DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)
  grantedByUserId String          @map("granted_by_user_id") @db.Uuid
  grantedBy       User            @relation("EmployeeSkillGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([employeeUserId, revokedAt, skillId], map: "employee_skills_employee_idx")
  @@index([skillId, revokedAt, employeeUserId], map: "employee_skills_skill_idx")
  @@index([grantedByUserId], map: "employee_skills_grantor_idx")
  @@map("employee_skills")
}

// Branch-local wall-clock minutes since midnight, never UTC instants. ISO weekday
// 1 = Monday ... 7 = Sunday. Defaults are applied by branch configuration, not here.
model BranchOperatingHours {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  isoWeekday     Int      @map("iso_weekday") @db.SmallInt
  isClosed       Boolean  @default(false) @map("is_closed")
  opensAtMinute  Int?     @map("opens_at_minute") @db.SmallInt
  closesAtMinute Int?     @map("closes_at_minute") @db.SmallInt
  rowVersion     Int      @default(1) @map("row_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, isoWeekday], map: "branch_operating_hours_branch_weekday_key")
  @@map("branch_operating_hours")
}

// businessDate is the check-in date in the branch timezone (SQL-enforced). One record
// per employee, branch and business date; no breaks and no pay effects in Phase 2.
model AttendanceRecord {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeUserId String          @map("employee_user_id") @db.Uuid
  employee       EmployeeProfile @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  branchId       String          @map("branch_id") @db.Uuid
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessDate   DateTime        @map("business_date") @db.Date
  checkInAt      DateTime        @map("check_in_at") @db.Timestamptz(3)
  checkOutAt     DateTime?       @map("check_out_at") @db.Timestamptz(3)
  rowVersion     Int             @default(1) @map("row_version")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([employeeUserId, branchId, businessDate], map: "attendance_records_employee_branch_date_key")
  @@index([branchId, businessDate, employeeUserId], map: "attendance_records_branch_date_idx")
  @@index([employeeUserId, checkOutAt], map: "attendance_records_employee_open_idx")
  @@map("attendance_records")
}

// Whole calendar days. PENDING -> APPROVED | REJECTED | CANCELLED, and APPROVED ->
// CANCELLED for a later authorized workflow; SQL rejects every other transition.
model LeaveRequest {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeUserId     String          @map("employee_user_id") @db.Uuid
  employee           EmployeeProfile @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  startDate          DateTime        @map("start_date") @db.Date
  endDate            DateTime        @map("end_date") @db.Date
  leaveType          LeaveType       @map("leave_type")
  reason             String
  status             LeaveStatus     @default(PENDING)
  requestedAt        DateTime        @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedByUserId    String?         @map("decided_by_user_id") @db.Uuid
  decidedBy          User?           @relation("LeaveDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedAt          DateTime?       @map("decided_at") @db.Timestamptz(3)
  decisionReason     String?         @map("decision_reason")
  cancelledByUserId  String?         @map("cancelled_by_user_id") @db.Uuid
  cancelledBy        User?           @relation("LeaveCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?         @map("cancellation_reason")
  rowVersion         Int             @default(1) @map("row_version")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([employeeUserId, status, startDate], map: "leave_requests_employee_idx")
  @@index([status, startDate, endDate], map: "leave_requests_status_dates_idx")
  @@index([decidedByUserId], map: "leave_requests_decider_idx")
  @@index([cancelledByUserId], map: "leave_requests_canceller_idx")
  @@map("leave_requests")
}

enum CollaboratorWorkMode {
  SHIFT
  FULL_DAY
}

enum CollaboratorWorkStatus {
  SCHEDULED
  CANCELLED
}

// Follow-up Step 6: one row per collaborator (CTV) work occurrence; never deleted.
// workDate is the branch-local business date; startMinute/endMinute are minutes of that
// day (no overnight). FULL_DAY stores the branch opening hours as a snapshot when agreed.
// agreedPayVnd is the manually agreed amount for this occurrence (never hours x rate, never
// changed by attendance); null = not agreed yet. It is the single economic source amount
// later payroll and branch cost reporting reference (personnel/operating cost).
// SQL-only: shape CHECKs, the FULL_DAY partial unique index and the history guard trigger.
model CollaboratorWorkOccurrence {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeUserId    String                 @map("employee_user_id") @db.Uuid
  employee          EmployeeProfile        @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  branchId          String                 @map("branch_id") @db.Uuid
  branch            Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workDate          DateTime               @map("work_date") @db.Date
  mode              CollaboratorWorkMode
  startMinute       Int                    @map("start_minute") @db.SmallInt
  endMinute         Int                    @map("end_minute") @db.SmallInt
  agreedPayVnd      BigInt?                @map("agreed_pay_vnd")
  status            CollaboratorWorkStatus @default(SCHEDULED)
  note              String?
  createdByUserId   String                 @map("created_by_user_id") @db.Uuid
  createdBy         User                   @relation("CollaboratorWorkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedByUserId   String                 @map("updated_by_user_id") @db.Uuid
  updatedBy         User                   @relation("CollaboratorWorkUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledByUserId String?                @map("cancelled_by_user_id") @db.Uuid
  cancelledBy       User?                  @relation("CollaboratorWorkCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledAt       DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?                @map("cancel_reason")
  rowVersion        Int                    @default(1) @map("row_version")

  @@index([employeeUserId, workDate, status], map: "collaborator_work_employee_date_idx")
  @@index([branchId, workDate, status], map: "collaborator_work_branch_date_idx")
  @@index([createdByUserId], map: "collaborator_work_creator_idx")
  @@index([updatedByUserId], map: "collaborator_work_updater_idx")
  @@index([cancelledByUserId], map: "collaborator_work_canceller_idx")
  @@map("collaborator_work_occurrences")
}

// ---------------------------------------------------------------- Phase 3 (Booking & Visits)
// docs/PHASE3_BOOKING_VISITS_DESIGN.md. SQL-only: shape CHECKs, status-fact rules, partial
// unique indexes, lifecycle/history guard triggers, the branch-local service_date rule and the
// ktv_occupancies btree_gist exclusion backstop (O9).

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum BookingChannel {
  ONLINE
  DESK
}

enum BookingRecipientRelation {
  SELF
  CHILD
  FAMILY
  OTHER
}

enum KtvAssignmentMode {
  SPECIFIC
  ANY
}

enum AssignmentConflict {
  LEAVE
}

enum AssignmentChangeReason {
  LEAVE
  CUSTOMER_CHOICE
  MANAGER
}

enum VisitOrigin {
  BOOKING
  WALK_IN
}

enum VisitStatus {
  OPEN
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum VisitParticipantKind {
  MEMBER
  GUEST
  CHILD
}

enum VisitServiceLineStatus {
  WAITING
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ServiceExecutionStatus {
  IN_PROGRESS
  ENDED
}

enum ServiceExecutionEndKind {
  NORMAL
  MANAGER_RESOLVED
}

// A member's reservation (design section 3). Created CONFIRMED only (O4); terminal states are
// CHECKED_IN (the visit owns progress), CANCELLED and NO_SHOW. The owner is a customer account.
model Booking {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String               @unique(map: "bookings_code_key")
  branchId          String               @map("branch_id") @db.Uuid
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerUserId       String               @map("owner_user_id") @db.Uuid
  owner             User                 @relation("BookingOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status            BookingStatus        @default(CONFIRMED)
  channel           BookingChannel
  startsAt          DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime             @map("ends_at") @db.Timestamptz(3)
  serviceDate       DateTime             @map("service_date") @db.Date
  idempotencyKey    String               @map("idempotency_key") @db.Uuid
  createdByUserId   String               @map("created_by_user_id") @db.Uuid
  createdBy         User                 @relation("BookingCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkedInAt       DateTime?            @map("checked_in_at") @db.Timestamptz(3)
  checkedInByUserId String?              @map("checked_in_by_user_id") @db.Uuid
  checkedInBy       User?                @relation("BookingCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledAt       DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId String?              @map("cancelled_by_user_id") @db.Uuid
  cancelledBy       User?                @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelReason      String?              @map("cancel_reason")
  cancelledLate     Boolean?             @map("cancelled_late")
  noShowAt          DateTime?            @map("no_show_at") @db.Timestamptz(3)
  noShowByUserId    String?              @map("no_show_by_user_id") @db.Uuid
  noShowBy          User?                @relation("BookingNoShowBy", fields: [noShowByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  noShowReason      String?              @map("no_show_reason")
  rowVersion        Int                  @default(1) @map("row_version")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  recipients        BookingRecipient[]
  lines             BookingServiceLine[]
  visit             Visit?

  @@unique([createdByUserId, idempotencyKey], map: "bookings_creator_idempotency_key")
  @@index([branchId, serviceDate, status], map: "bookings_branch_date_idx")
  @@index([ownerUserId, startsAt], map: "bookings_owner_idx")
  @@index([checkedInByUserId], map: "bookings_checked_in_by_idx")
  @@index([cancelledByUserId], map: "bookings_cancelled_by_idx")
  @@index([noShowByUserId], map: "bookings_no_show_by_idx")
  @@map("bookings")
}

// The service recipient of booking lines (O11): SELF = the owner; otherwise a named family
// member or other recipient. Never an account.
model BookingRecipient {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String                   @map("booking_id") @db.Uuid
  booking      Booking                  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  relation     BookingRecipientRelation
  displayName  String?                  @map("display_name")
  phone        String?
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lines        BookingServiceLine[]
  participants VisitParticipant[]

  @@unique([bookingId, id], map: "booking_recipients_booking_id_id_key")
  @@map("booking_recipients")
}

// One requested service: KTV per line (Q3), duration and buffer snapshots (O7) and the
// catalog reference snapshot (O5, historical reference only; no billing).
model BookingServiceLine {
  id                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String                        @map("booking_id") @db.Uuid
  booking            Booking                       @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sequence           Int                           @db.SmallInt
  recipientId        String                        @map("recipient_id") @db.Uuid
  recipient          BookingRecipient              @relation(fields: [bookingId, recipientId], references: [bookingId, id], onDelete: Restrict, onUpdate: Restrict)
  serviceId          String                        @map("service_id") @db.Uuid
  service            Service                       @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeUserId     String                        @map("employee_user_id") @db.Uuid
  employee           EmployeeProfile               @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  assignmentMode     KtvAssignmentMode             @map("assignment_mode")
  plannedStartAt     DateTime                      @map("planned_start_at") @db.Timestamptz(3)
  plannedEndAt       DateTime                      @map("planned_end_at") @db.Timestamptz(3)
  durationMinutes    Int                           @map("duration_minutes")
  bufferMinutes      Int                           @map("buffer_minutes")
  serviceCode        String                        @map("service_code")
  serviceNameVi      String                        @map("service_name_vi")
  serviceNameEn      String                        @map("service_name_en")
  catalogPriceMinVnd BigInt                        @map("catalog_price_min_vnd")
  catalogPriceMaxVnd BigInt                        @map("catalog_price_max_vnd")
  catalogPricingUnit ServicePricingUnit            @map("catalog_pricing_unit")
  /// Phase 4 OP-1: the service's quantity limit when the line was established (immutable snapshot).
  maxQuantitySnapshot Int                          @default(1) @map("max_quantity_snapshot")
  assignmentConflict AssignmentConflict?           @map("assignment_conflict")
  rowVersion         Int                           @default(1) @map("row_version")
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  visitLine          VisitServiceLine?
  assignmentChanges  ServiceLineAssignmentChange[]

  @@unique([bookingId, sequence], map: "booking_service_lines_booking_sequence_key")
  @@index([employeeUserId, plannedStartAt], map: "booking_service_lines_employee_idx")
  @@index([serviceId], map: "booking_service_lines_service_idx")
  @@index([bookingId, recipientId], map: "booking_service_lines_recipient_idx")
  @@map("booking_service_lines")
}

// An on-site stay (design section 4): from a booking at check-in, or a walk-in.
model Visit {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String             @unique(map: "visits_code_key")
  branchId              String             @map("branch_id") @db.Uuid
  branch                Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  origin                VisitOrigin
  bookingId             String?            @unique(map: "visits_booking_id_key") @map("booking_id") @db.Uuid
  booking               Booking?           @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerUserId           String?            @map("owner_user_id") @db.Uuid
  owner                 User?              @relation("VisitOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status                VisitStatus        @default(OPEN)
  serviceDate           DateTime           @map("service_date") @db.Date
  arrivedAt             DateTime           @map("arrived_at") @db.Timestamptz(3)
  completedAt           DateTime?          @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId     String?            @map("cancelled_by_user_id") @db.Uuid
  cancelledBy           User?              @relation("VisitCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelReason          String?            @map("cancel_reason")
  queueOverrideAt       DateTime?          @map("queue_override_at") @db.Timestamptz(3)
  queueOverrideByUserId String?            @map("queue_override_by_user_id") @db.Uuid
  queueOverrideBy       User?              @relation("VisitQueueOverrideBy", fields: [queueOverrideByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId       String             @map("created_by_user_id") @db.Uuid
  createdBy             User               @relation("VisitCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  idempotencyKey        String?            @map("idempotency_key") @db.Uuid
  rowVersion            Int                @default(1) @map("row_version")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  participants          VisitParticipant[]
  lines                 VisitServiceLine[]
  invoices              Invoice[]

  @@unique([createdByUserId, idempotencyKey], map: "visits_creator_idempotency_key")
  @@index([branchId, serviceDate, status], map: "visits_branch_date_idx")
  @@index([ownerUserId], map: "visits_owner_idx")
  @@index([cancelledByUserId], map: "visits_cancelled_by_idx")
  @@index([queueOverrideByUserId], map: "visits_queue_override_by_idx")
  @@map("visits")
}

// Who receives services (design section 9): MEMBER (a customer account), GUEST or CHILD
// (never accounts; a child names a guardian participant of the same visit).
model VisitParticipant {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId               String               @map("visit_id") @db.Uuid
  visit                 Visit                @relation(fields: [visitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind                  VisitParticipantKind
  customerUserId        String?              @map("customer_user_id") @db.Uuid
  customer              User?                @relation(fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  displayName           String?              @map("display_name")
  phone                 String?
  note                  String?
  guardianParticipantId String?              @map("guardian_participant_id") @db.Uuid
  guardian              VisitParticipant?    @relation("ParticipantGuardian", fields: [visitId, guardianParticipantId], references: [visitId, id], onDelete: Restrict, onUpdate: Restrict)
  wards                 VisitParticipant[]   @relation("ParticipantGuardian")
  bookingRecipientId    String?              @unique(map: "visit_participants_booking_recipient_id_key") @map("booking_recipient_id") @db.Uuid
  bookingRecipient      BookingRecipient?    @relation(fields: [bookingRecipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lines                 VisitServiceLine[]
  invoiceLineServices   InvoiceLineService[]

  @@unique([visitId, id], map: "visit_participants_visit_id_id_key")
  @@index([customerUserId], map: "visit_participants_customer_idx")
  @@index([visitId, guardianParticipantId], map: "visit_participants_guardian_idx")
  @@map("visit_participants")
}

// One service for one participant, with its KTV, planned window, snapshots (O5, O7) and the
// START-overdue warning fact (O1).
model VisitServiceLine {
  id                      String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId                 String                        @map("visit_id") @db.Uuid
  visit                   Visit                         @relation(fields: [visitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participantId           String                        @map("participant_id") @db.Uuid
  participant             VisitParticipant              @relation(fields: [visitId, participantId], references: [visitId, id], onDelete: Restrict, onUpdate: Restrict)
  sequence                Int                           @db.SmallInt
  bookingServiceLineId    String?                       @unique(map: "visit_service_lines_booking_service_line_id_key") @map("booking_service_line_id") @db.Uuid
  bookingServiceLine      BookingServiceLine?           @relation(fields: [bookingServiceLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceId               String                        @map("service_id") @db.Uuid
  service                 Service                       @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeUserId          String?                       @map("employee_user_id") @db.Uuid
  employee                EmployeeProfile?              @relation("VisitLineEmployee", fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  assignmentMode          KtvAssignmentMode             @map("assignment_mode")
  /// Step 6: the KTV a SPECIFIC walk-in line asks for while it waits (never an assignment).
  requestedEmployeeUserId String?                       @map("requested_employee_user_id") @db.Uuid
  requestedEmployee       EmployeeProfile?              @relation("VisitLineRequestedEmployee", fields: [requestedEmployeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  status                  VisitServiceLineStatus        @default(PLANNED)
  plannedStartAt          DateTime?                     @map("planned_start_at") @db.Timestamptz(3)
  plannedEndAt            DateTime?                     @map("planned_end_at") @db.Timestamptz(3)
  durationMinutes         Int                           @map("duration_minutes")
  bufferMinutes           Int?                          @map("buffer_minutes")
  serviceCode             String                        @map("service_code")
  serviceNameVi           String                        @map("service_name_vi")
  serviceNameEn           String                        @map("service_name_en")
  catalogPriceMinVnd      BigInt                        @map("catalog_price_min_vnd")
  catalogPriceMaxVnd      BigInt                        @map("catalog_price_max_vnd")
  catalogPricingUnit      ServicePricingUnit            @map("catalog_pricing_unit")
  /// Phase 4 OP-1: the service's quantity limit when the line was established (immutable snapshot).
  /// The line itself has NO quantity: one line is one performed service.
  maxQuantitySnapshot     Int                           @default(1) @map("max_quantity_snapshot")
  addedOnBehalf           Boolean                       @default(false) @map("added_on_behalf")
  addedByUserId           String?                       @map("added_by_user_id") @db.Uuid
  addedBy                 User?                         @relation("VisitLineAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addedAt                 DateTime?                     @map("added_at") @db.Timestamptz(3)
  cancelledAt             DateTime?                     @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId       String?                       @map("cancelled_by_user_id") @db.Uuid
  cancelledBy             User?                         @relation("VisitLineCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelReason            String?                       @map("cancel_reason")
  assignmentConflict      AssignmentConflict?           @map("assignment_conflict")
  startOverdueWarnedAt    DateTime?                     @map("start_overdue_warned_at") @db.Timestamptz(3)
  rowVersion              Int                           @default(1) @map("row_version")
  createdAt               DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  execution               ServiceExecution?
  warningSchedules        ServiceWarningSchedule[]
  assignmentChanges       ServiceLineAssignmentChange[]
  addRequest              VisitLineAddRequest?
  invoiceLineServices     InvoiceLineService[]

  @@unique([participantId, sequence], map: "visit_service_lines_participant_sequence_key")
  @@index([visitId, participantId], map: "visit_service_lines_visit_idx")
  @@index([employeeUserId, plannedStartAt], map: "visit_service_lines_employee_idx")
  @@index([serviceId], map: "visit_service_lines_service_idx")
  @@index([requestedEmployeeUserId], map: "visit_service_lines_requested_employee_idx")
  @@index([addedByUserId], map: "visit_service_lines_added_by_idx")
  @@index([cancelledByUserId], map: "visit_service_lines_cancelled_by_idx")
  @@map("visit_service_lines")
}

// START/END facts of one visit line (design section 11): no auto-END; a Manager resolution
// carries a reason; pre-END and END-overdue warning facts (O1).
model ServiceExecution {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitServiceLineId String                   @unique(map: "service_executions_visit_service_line_id_key") @map("visit_service_line_id") @db.Uuid
  visitServiceLine   VisitServiceLine         @relation(fields: [visitServiceLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeUserId     String                   @map("employee_user_id") @db.Uuid
  employee           EmployeeProfile          @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  status             ServiceExecutionStatus   @default(IN_PROGRESS)
  startedAt          DateTime                 @map("started_at") @db.Timestamptz(3)
  expectedEndAt      DateTime                 @map("expected_end_at") @db.Timestamptz(3)
  endedAt            DateTime?                @map("ended_at") @db.Timestamptz(3)
  endKind            ServiceExecutionEndKind? @map("end_kind")
  endedByUserId      String?                  @map("ended_by_user_id") @db.Uuid
  endedBy            User?                    @relation("ExecutionEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolutionReason   String?                  @map("resolution_reason")
  preEndWarnedAt     DateTime?                @map("pre_end_warned_at") @db.Timestamptz(3)
  endOverdueWarnedAt DateTime?                @map("end_overdue_warned_at") @db.Timestamptz(3)
  rowVersion         Int                      @default(1) @map("row_version")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([employeeUserId, status], map: "service_executions_employee_idx")
  @@index([endedByUserId], map: "service_executions_ended_by_idx")
  @@map("service_executions")
}

// Phase 4 Step 3: replay protection of "add a service to a visit" (client UUID key, unique per actor).
// Append-only; the created line is the stored outcome of the key.
model VisitLineAddRequest {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId        String           @map("actor_user_id") @db.Uuid
  actor              User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  idempotencyKey     String           @map("idempotency_key") @db.Uuid
  visitServiceLineId String           @unique(map: "visit_line_add_requests_line_key") @map("visit_service_line_id") @db.Uuid
  visitServiceLine   VisitServiceLine @relation(fields: [visitServiceLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorUserId, idempotencyKey], map: "visit_line_add_requests_actor_key")
  @@map("visit_line_add_requests")
}

// Append-only KTV reassignment history (design section 10).
model ServiceLineAssignmentChange {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingServiceLineId String?                @map("booking_service_line_id") @db.Uuid
  bookingServiceLine   BookingServiceLine?    @relation(fields: [bookingServiceLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  visitServiceLineId   String?                @map("visit_service_line_id") @db.Uuid
  visitServiceLine     VisitServiceLine?      @relation(fields: [visitServiceLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromEmployeeUserId   String                 @map("from_employee_user_id") @db.Uuid
  fromEmployee         EmployeeProfile        @relation("AssignmentFrom", fields: [fromEmployeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  toEmployeeUserId     String                 @map("to_employee_user_id") @db.Uuid
  toEmployee           EmployeeProfile        @relation("AssignmentTo", fields: [toEmployeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  reason               AssignmentChangeReason
  note                 String?
  actorUserId          String                 @map("actor_user_id") @db.Uuid
  actor                User                   @relation("AssignmentActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  occurredAt           DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([bookingServiceLineId, occurredAt], map: "assignment_changes_booking_line_idx")
  @@index([visitServiceLineId, occurredAt], map: "assignment_changes_visit_line_idx")
  @@index([fromEmployeeUserId], map: "assignment_changes_from_idx")
  @@index([toEmployeeUserId], map: "assignment_changes_to_idx")
  @@index([actorUserId], map: "assignment_changes_actor_idx")
  @@map("service_line_assignment_changes")
}

// The configuration registry (design section 18): code-owned keys (booking-settings.ts),
// integer values validated in SQL, seeded with the approved defaults.
model AppSetting {
  key             String   @id
  value           Json     @db.JsonB
  rowVersion      Int      @default(1) @map("row_version")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedByUserId], map: "app_settings_updated_by_idx")
  @@map("app_settings")
}

// Derived KTV occupancy, written only by database triggers; the btree_gist exclusion
// constraint (SQL-only) rejects overlapping intervals for one KTV (O9).
model KtvOccupancy {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeUserId       String                   @map("employee_user_id") @db.Uuid
  period               Unsupported("tstzrange")
  bookingServiceLineId String?                  @unique(map: "ktv_occupancies_booking_service_line_id_key") @map("booking_service_line_id") @db.Uuid
  visitServiceLineId   String?                  @unique(map: "ktv_occupancies_visit_service_line_id_key") @map("visit_service_line_id") @db.Uuid

  @@map("ktv_occupancies")
}

// ---------------------------------------------------------------------------------------------
// Phase 4 Step 4: POS database foundation (design docs/PHASE4_POS_INVOICE_PAYMENTS_DESIGN.md
// sections 4.1-4.5). Tables only: the Invoice/POS, discount and payment workflows are Steps 5-8.
// SQL adds the CHECKs, the state/immutability guards, the deferred integrity triggers and the
// partial unique indexes (one non-CANCELLED invoice per visit; one active supplied voucher).
// ---------------------------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum InvoiceLineKind {
  SERVICE
}

enum PaymentMethod {
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentCorrectionKind {
  REVERSAL
}

enum DiscountKind {
  PERCENT
  FIXED_AMOUNT
}

enum DiscountScopeMode {
  ALL_SERVICES
  SELECTED
}

enum DiscountReleaseCause {
  INVOICE_CANCELLED_UNPAID
  ZERO_BALANCE_CORRECTION
}

// The internal commercial receipt of ONE visit (never an official VAT/e-invoice). The payer is a
// customer account or NULL (guest). Amounts are integer VND; total = subtotal - discountTotal is
// the receivable and may be 0. Status transitions and freezing are guarded in SQL.
model Invoice {
  id                  String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                        @unique(map: "invoices_code_key")
  branchId            String                        @map("branch_id") @db.Uuid
  branch              Branch                        @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  visitId             String                        @map("visit_id") @db.Uuid
  visit               Visit                         @relation(fields: [visitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status              InvoiceStatus                 @default(DRAFT)
  payerUserId         String?                       @map("payer_user_id") @db.Uuid
  payer               User?                         @relation("InvoicePayer", fields: [payerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessDate        DateTime                      @map("business_date") @db.Date
  calculationVersion  Int                           @map("calculation_version")
  subtotalVnd         BigInt                        @default(0) @map("subtotal_vnd")
  discountTotalVnd    BigInt                        @default(0) @map("discount_total_vnd")
  totalVnd            BigInt                        @default(0) @map("total_vnd")
  finalizedAt         DateTime?                     @map("finalized_at") @db.Timestamptz(3)
  finalizedByUserId   String?                       @map("finalized_by_user_id") @db.Uuid
  finalizedBy         User?                         @relation("InvoiceFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledAt         DateTime?                     @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId   String?                       @map("cancelled_by_user_id") @db.Uuid
  cancelledBy         User?                         @relation("InvoiceCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledFromStatus InvoiceStatus?                @map("cancelled_from_status")
  cancelReason        String?                       @map("cancel_reason")
  paidAt              DateTime?                     @map("paid_at") @db.Timestamptz(3)
  paidSeq             Int                           @default(0) @map("paid_seq")
  createdByUserId     String                        @map("created_by_user_id") @db.Uuid
  createdBy           User                          @relation("InvoiceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rowVersion          Int                           @default(1) @map("row_version")
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines               InvoiceLine[]
  payments            Payment[]
  voucherEntries      InvoiceVoucherEntry[]
  discountApplication InvoiceDiscountApplication?
  discountRedemption  DiscountRedemption?

  @@index([branchId, businessDate, status], map: "invoices_branch_date_idx")
  @@index([payerUserId, createdAt], map: "invoices_payer_idx")
  @@map("invoices")
}

// Generic invoice line; kind selects the 1:1 detail table (Phase 4 defines only SERVICE).
// Quantity and price stay NULL until set (a DRAFT may be unpriced); gross = quantity x price.
model InvoiceLine {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId        String               @map("invoice_id") @db.Uuid
  invoice          Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sequence         Int                  @db.SmallInt
  kind             InvoiceLineKind      @default(SERVICE)
  itemCode         String               @map("item_code")
  nameVi           String               @map("name_vi")
  nameEn           String               @map("name_en")
  quantity         Int?
  unitPriceVnd     BigInt?              @map("unit_price_vnd")
  grossVnd         BigInt?              @map("gross_vnd")
  priceSetByUserId String?              @map("price_set_by_user_id") @db.Uuid
  priceSetBy       User?                @relation("InvoiceLinePriceSetBy", fields: [priceSetByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  priceSetAt       DateTime?            @map("price_set_at") @db.Timestamptz(3)
  rowVersion       Int                  @default(1) @map("row_version")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  // SQL: exactly one detail row per SERVICE line (its primary key is the line id).
  serviceDetails   InvoiceLineService[]

  @@unique([invoiceId, sequence], map: "invoice_lines_invoice_sequence_key")
  @@unique([invoiceId, id], map: "invoice_lines_invoice_id_id_key")
  @@map("invoice_lines")
}

// The SERVICE detail: an exact copy of the visit-line snapshot (including the per-service quantity
// limit snapshotted when that line was established, OP-1). One VisitServiceLine stays one
// operational performance; it appears at most once per invoice.
model InvoiceLineService {
  invoiceLineId      String             @id @map("invoice_line_id") @db.Uuid
  invoiceId          String             @map("invoice_id") @db.Uuid
  line               InvoiceLine        @relation(fields: [invoiceId, invoiceLineId], references: [invoiceId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_line_services_line_fkey")
  visitServiceLineId String             @map("visit_service_line_id") @db.Uuid
  visitServiceLine   VisitServiceLine   @relation(fields: [visitServiceLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceId          String             @map("service_id") @db.Uuid
  service            Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participantId      String             @map("participant_id") @db.Uuid
  participant        VisitParticipant   @relation(fields: [participantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeUserId     String             @map("employee_user_id") @db.Uuid
  employee           EmployeeProfile    @relation(fields: [employeeUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  pricingUnit        ServicePricingUnit @map("pricing_unit")
  catalogPriceMinVnd BigInt             @map("catalog_price_min_vnd")
  catalogPriceMaxVnd BigInt             @map("catalog_price_max_vnd")
  quantityLimit      Int                @map("quantity_limit")
  addedOnBehalf      Boolean            @map("added_on_behalf")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([invoiceId, visitServiceLineId], map: "invoice_line_services_invoice_visit_line_key")
  @@index([serviceId], map: "invoice_line_services_service_idx")
  @@index([employeeUserId], map: "invoice_line_services_employee_idx")
  @@map("invoice_line_services")
}

// Cash shape (Step 8 extends it). collectedAt and businessDate defaults are placeholders: SQL
// always overwrites them with the database clock. A payment is never edited; a reversal is a
// PaymentCorrection. There is no zero-VND payment and a zero-balance invoice has no payment row.
model Payment {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId         String             @map("invoice_id") @db.Uuid
  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId          String             @map("branch_id") @db.Uuid
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  method            PaymentMethod
  status            PaymentStatus
  amountDueVnd      BigInt             @map("amount_due_vnd")
  amountVnd         BigInt             @map("amount_vnd")
  tenderedVnd       BigInt             @map("tendered_vnd")
  changeVnd         BigInt             @map("change_vnd")
  collectedByUserId String             @map("collected_by_user_id") @db.Uuid
  collectedBy       User               @relation("PaymentCollector", fields: [collectedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collectedAt       DateTime           @default(dbgenerated("clock_timestamp()")) @map("collected_at") @db.Timestamptz(3)
  businessDate      DateTime           @default(dbgenerated("CURRENT_DATE")) @map("business_date") @db.Date
  idempotencyKey    String             @map("idempotency_key") @db.Uuid
  rowVersion        Int                @default(1) @map("row_version")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  correction        PaymentCorrection?

  @@unique([collectedByUserId, idempotencyKey], map: "payments_collector_idempotency_key")
  @@index([invoiceId], map: "payments_invoice_idx")
  @@map("payments")
}

// Append-only: a payment is reversed at most once; the original payment row is never edited.
model PaymentCorrection {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String                @unique(map: "payment_corrections_payment_key") @map("payment_id") @db.Uuid
  payment     Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind        PaymentCorrectionKind @default(REVERSAL)
  reason      String
  actorUserId String                @map("actor_user_id") @db.Uuid
  actor       User                  @relation("PaymentCorrectionActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  occurredAt  DateTime              @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(3)

  @@map("payment_corrections")
}

// An Owner-configured discount program (never deleted). requiresCode = false is a code-less
// promotion (an automatic candidate); true owns voucher codes. Configuration lives in versions.
model Discount {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String               @unique(map: "discounts_code_key")
  nameVi             String               @map("name_vi")
  nameEn             String               @map("name_en")
  requiresCode       Boolean              @map("requires_code")
  isActive           Boolean              @default(true) @map("is_active")
  terminatedAt       DateTime?            @map("terminated_at") @db.Timestamptz(3)
  terminatedByUserId String?              @map("terminated_by_user_id") @db.Uuid
  terminatedBy       User?                @relation("DiscountTerminatedBy", fields: [terminatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  terminatedReason   String?              @map("terminated_reason")
  rowVersion         Int                  @default(1) @map("row_version")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions           DiscountVersion[]
  vouchers           Voucher[]
  redemptions        DiscountRedemption[]

  @@map("discounts")
}

// Immutable configuration (append-only): a percentage in basis points (1..10000) or a fixed VND
// amount, validity window, minimum spend, scope, and NULL-means-unlimited usage limits.
model DiscountVersion {
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discountId            String                       @map("discount_id") @db.Uuid
  discount              Discount                     @relation(fields: [discountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionNo             Int                          @map("version_no")
  kind                  DiscountKind
  percentBp             Int?                         @map("percent_bp")
  fixedAmountVnd        BigInt?                      @map("fixed_amount_vnd")
  validFrom             DateTime                     @map("valid_from") @db.Timestamptz(3)
  validUntil            DateTime                     @map("valid_until") @db.Timestamptz(3)
  minSpendVnd           BigInt                       @default(0) @map("min_spend_vnd")
  scopeMode             DiscountScopeMode            @map("scope_mode")
  usageLimitTotal       Int?                         @map("usage_limit_total")
  usageLimitPerCustomer Int?                         @map("usage_limit_per_customer")
  createdByUserId       String                       @map("created_by_user_id") @db.Uuid
  createdBy             User                         @relation("DiscountVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  services              DiscountVersionService[]
  categories            DiscountVersionCategory[]
  applications          InvoiceDiscountApplication[]
  redemptions           DiscountRedemption[]

  @@unique([discountId, versionNo], map: "discount_versions_discount_version_key")
  @@unique([discountId, id], map: "discount_versions_discount_id_id_key")
  @@map("discount_versions")
}

model DiscountVersionService {
  versionId String          @map("version_id") @db.Uuid
  version   DiscountVersion @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceId String          @map("service_id") @db.Uuid
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([versionId, serviceId])
  @@map("discount_version_services")
}

model DiscountVersionCategory {
  versionId  String          @map("version_id") @db.Uuid
  version    DiscountVersion @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categoryId String          @map("category_id") @db.Uuid
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([versionId, categoryId])
  @@map("discount_version_categories")
}

// A redeemable code under a requiresCode program (canonical upper-case).
model Voucher {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discountId      String                       @map("discount_id") @db.Uuid
  discount        Discount                     @relation(fields: [discountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code            String                       @unique(map: "vouchers_code_key")
  isActive        Boolean                      @default(true) @map("is_active")
  createdByUserId String                       @map("created_by_user_id") @db.Uuid
  createdBy       User                         @relation("VoucherCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rowVersion      Int                          @default(1) @map("row_version")
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  entries         InvoiceVoucherEntry[]
  applications    InvoiceDiscountApplication[]
  redemptions     DiscountRedemption[]

  @@map("vouchers")
}

// The voucher codes supplied to a DRAFT invoice (the voucher candidates). A single removal
// transition, draft only; SQL keeps one ACTIVE entry per (invoice, voucher).
model InvoiceVoucherEntry {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId        String    @map("invoice_id") @db.Uuid
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voucherId        String    @map("voucher_id") @db.Uuid
  voucher          Voucher   @relation(fields: [voucherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  suppliedByUserId String    @map("supplied_by_user_id") @db.Uuid
  suppliedBy       User      @relation("VoucherEntrySuppliedBy", fields: [suppliedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  suppliedAt       DateTime  @default(now()) @map("supplied_at") @db.Timestamptz(3)
  removedByUserId  String?   @map("removed_by_user_id") @db.Uuid
  removedBy        User?     @relation("VoucherEntryRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedAt        DateTime? @map("removed_at") @db.Timestamptz(3)

  @@map("invoice_voucher_entries")
}

// The single winning benefit, written once at finalization (immutable). SQL enforces the Q3 amount
// rule (percent half up to 1 VND; fixed capped by the eligible subtotal).
model InvoiceDiscountApplication {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId           String          @unique(map: "invoice_discount_applications_invoice_key") @map("invoice_id") @db.Uuid
  invoice             Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  discountId          String          @map("discount_id") @db.Uuid
  versionId           String          @map("version_id") @db.Uuid
  version             DiscountVersion @relation(fields: [discountId, versionId], references: [discountId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_discount_applications_version_fkey")
  voucherId           String?         @map("voucher_id") @db.Uuid
  voucher             Voucher?        @relation(fields: [voucherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind                DiscountKind
  percentBp           Int?            @map("percent_bp")
  fixedAmountVnd      BigInt?         @map("fixed_amount_vnd")
  eligibleSubtotalVnd BigInt          @map("eligible_subtotal_vnd")
  computedAmountVnd   BigInt          @map("computed_amount_vnd")
  candidates          Json            @db.JsonB
  selectionReason     String          @map("selection_reason")
  finalizedByUserId   String          @map("finalized_by_user_id") @db.Uuid
  finalizedBy         User            @relation("DiscountApplicationFinalizer", fields: [finalizedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  appliedAt           DateTime        @default(dbgenerated("clock_timestamp()")) @map("applied_at") @db.Timestamptz(3)

  @@map("invoice_discount_applications")
}

// The permanent usage ledger: one redemption per invoice for the winner only; active iff it has
// no release. redeemedAt is always the database clock (SQL overwrites it).
model DiscountRedemption {
  id          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String                     @unique(map: "discount_redemptions_invoice_key") @map("invoice_id") @db.Uuid
  invoice     Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  discountId  String                     @map("discount_id") @db.Uuid
  discount    Discount                   @relation(fields: [discountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionId   String                     @map("version_id") @db.Uuid
  version     DiscountVersion            @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voucherId   String?                    @map("voucher_id") @db.Uuid
  voucher     Voucher?                   @relation(fields: [voucherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payerUserId String?                    @map("payer_user_id") @db.Uuid
  payer       User?                      @relation("DiscountRedemptionPayer", fields: [payerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  redeemedAt  DateTime                   @default(dbgenerated("clock_timestamp()")) @map("redeemed_at") @db.Timestamptz(3)
  release     DiscountRedemptionRelease?

  @@index([discountId, payerUserId], map: "discount_redemptions_usage_idx")
  @@map("discount_redemptions")
}

// Append-only release of a redemption (at most once, only for a CANCELLED invoice).
model DiscountRedemptionRelease {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  redemptionId     String               @unique(map: "discount_redemption_releases_redemption_key") @map("redemption_id") @db.Uuid
  redemption       DiscountRedemption   @relation(fields: [redemptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  releasedAt       DateTime             @default(dbgenerated("clock_timestamp()")) @map("released_at") @db.Timestamptz(3)
  releasedByUserId String               @map("released_by_user_id") @db.Uuid
  releasedBy       User                 @relation("DiscountReleaseActor", fields: [releasedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cause            DiscountReleaseCause
  reason           String

  @@map("discount_redemption_releases")
}
