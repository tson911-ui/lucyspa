generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// Phase 0 branch identity, extended only with Phase 1 authorization relations.
model Branch {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String                       @unique
  name                    String
  timezone                String                       @default("Asia/Ho_Chi_Minh")
  isActive                Boolean                      @default(true) @map("is_active")
  rowVersion              Int                          @default(1) @map("row_version")
  areaId                  String?                      @map("area_id") @db.Uuid
  area                    Area?                        @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teams                   Team[]
  teamMemberships         TeamMembership[]
  organizationAssignments OrganizationAssignment[]
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  outboxEvents            OutboxEvent[]
  employeeAssignments     EmployeeBranchAssignment[]
  roleAssignments         UserRoleAssignment[]
  permissionOverrides     UserPermissionOverride[]
  auditEvents             AuditEvent[]
  serviceAvailability     ServiceBranchAvailability[]
  operatingHours          BranchOperatingHours[]
  shopInfoHours           WebsiteShopInfo[]
  attendanceRecords       AttendanceRecord[]
  collaboratorWork        CollaboratorWorkOccurrence[]
  bookings                Booking[]
  visits                  Visit[]
  notifications           Notification[]
  invoices                Invoice[]
  payments                Payment[]
  paymentAnomalies        PaymentAnomaly[]
  invoiceNotes            InvoiceManagementNote[]
  comboConsumptions       ComboSessionConsumption[]    @relation("ComboConsumptionBranch")
  rewardRedemptions       RewardRedemption[]           @relation("RewardRedemptionBranch")
  rewardManualUses        RewardManualUse[]            @relation("RewardManualUseBranch")
  productImportJobs       ProductImportJob[]           @relation("ImportJobBranch")
  stockReceipts           StockReceipt[]               @relation("StockReceiptBranch")
  productReturnCases      ProductReturnCase[]          @relation("ProductReturnBranch")
  productRefunds          ProductRefund[]              @relation("ProductRefundBranch")
  productExchanges        ProductExchange[]            @relation("ProductExchangeBranch")
  productOrders           ProductOrder[]               @relation("ProductOrderBranch")
  productOrderLines       ProductOrderLine[]           @relation("ProductOrderLineBranch")
  inventoryLots           InventoryLot[]               @relation("InventoryLotBranch")
  stockLevels             StockLevel[]                 @relation("StockLevelBranch")
  inventoryLowStockAlerts InventoryLowStockAlert[]     @relation("LowStockAlertBranch")
  inventoryExpiryScans    InventoryExpiryScan[]        @relation("ExpiryScanBranch")
  stockCounts             StockCountSession[]          @relation("StockCountBranch")
  stockMovements          StockMovement[]              @relation("StockMovementBranch")

  @@index([areaId], map: "branches_area_idx")
  @@map("branches")
}

// Durable event envelope, written in the originating business transaction.
// Publication/consumer behavior is deliberately deferred. Retain event history.
model OutboxEvent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String?             @map("branch_id") @db.Uuid
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  aggregateType String              @map("aggregate_type")
  aggregateId   String              @map("aggregate_id")
  eventType     String              @map("event_type")
  schemaVersion Int                 @default(1) @map("schema_version")
  payload       Json                @db.JsonB
  occurredAt    DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz(3)
  notifications Notification[]
  consumptions  OutboxConsumption[]

  @@index([publishedAt, occurredAt, id], map: "outbox_events_pending_idx")
  @@index([branchId], map: "outbox_events_branch_id_idx")
  @@index([eventType, id], map: "outbox_events_type_id_idx")
  @@map("outbox_events")
}

// Multi-consumer contract (Phase 4 design 15.2): one append-only row per (event, consumer). Financial events
// never use published_at, so no consumer can hide an event from another.
model OutboxConsumption {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String      @map("event_id") @db.Uuid
  event      OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumer   String
  outcome    String
  consumedAt DateTime    @default(dbgenerated("clock_timestamp()")) @map("consumed_at") @db.Timestamptz(3)

  @@unique([eventId, consumer], map: "outbox_consumptions_event_consumer_key")
  @@map("outbox_consumptions")
}

// Durable in-app inbox. Delivery retries never overwrite read state.
model Notification {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String      @map("recipient_user_id") @db.Uuid
  recipient       User        @relation(fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId        String?     @map("branch_id") @db.Uuid
  branch          Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceEventId   String      @map("source_event_id") @db.Uuid
  sourceEvent     OutboxEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type            String
  entityType      String      @map("entity_type")
  entityId        String      @map("entity_id") @db.Uuid
  contextCode     String      @map("context_code")
  actionAt        DateTime    @map("action_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt          DateTime?   @map("read_at") @db.Timestamptz(3)
  /// Structured ids/dates/enums only (validated by parseNotificationParams); never free text.
  params          Json?       @db.JsonB
  archivedAt      DateTime?   @map("archived_at") @db.Timestamptz(3)

  @@unique([sourceEventId, recipientUserId], map: "notifications_event_recipient_key")
  @@index([recipientUserId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_inbox_idx")
  @@index([recipientUserId, readAt], map: "notifications_unread_idx")
  @@map("notifications")
}

// Recoverable timer metadata, never execution state. Reuse the source warning facts.
model ServiceWarningSchedule {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineId    String           @map("line_id") @db.Uuid
  line      VisitServiceLine @relation(fields: [lineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind      String
  targetAt  DateTime         @map("target_at") @db.Timestamptz(3)
  dueAt     DateTime         @map("due_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([lineId, kind, targetAt], map: "service_warning_schedules_occurrence_key")
  @@map("service_warning_schedules")
}

